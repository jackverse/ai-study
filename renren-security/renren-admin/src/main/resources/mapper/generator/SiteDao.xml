<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="io.renren.modules.generator.dao.SiteDao">

    <select id="selectByUserId" resultType="io.renren.modules.generator.entity.SiteEntity">
        select * from site 
        where user_id = #{userId}
        order by created_at desc
    </select>

    <select id="selectByIdAndUserId" resultType="io.renren.modules.generator.entity.SiteEntity">
        select * from site 
        where id = #{id} and user_id = #{userId}
    </select>

</mapper>
